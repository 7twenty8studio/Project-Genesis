<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview: the Classic look with John 3:16 (KJV), verbatim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxLines="1"
            android:text="@string/verse_of_the_day"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:text="For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life."
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="John 3:16 · KJV"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:textStyle="italic" />
</LinearLayout>
