          "stringUnit": {
            "state": "translated",
            "value": "Adicione fotos, gravações de voz e páginas com o Pencil com o Premium."
          }
        }
      }
    },
    "Add the Memorize widget to your Home Screen or Lock Screen to recall a verse at a glance.": {
      "localizations": {
        "es": {
