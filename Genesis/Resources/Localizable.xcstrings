        }
      }
    },
    "A scholarly Methodist commentary with notes on language, history and customs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comentario metodista erudito, con notas sobre el idioma, la historia y las costumbres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um comentário metodista erudito, com notas sobre a língua, a história e os costumes."
          }
        }
      }
    },
    "A short guide explains the differences and suggests a Bible for study, everyday reading or reading aloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve guía explica las diferencias y sugiere una Biblia para el estudio, la lectura diaria o la lectura en voz alta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um guia curto explica as diferenças e sugere uma Bíblia para estudo, leitura diária ou leitura em voz alta."
          }
        }
      }
    },
    "A single tap selects a verse, ready to highlight, note or share.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo toque selecciona un versículo, listo para resaltar, anotar o compartir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque seleciona um versículo, pronto para destacar, anotar ou compartilhar."
          }
        }
      }
    },
    "A small gold ribbon when you finish a chapter or a day of your plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña cinta dorada al terminar un capítulo o un día de tu plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena fita dourada ao terminar um capítulo ou um dia do seu plano."
          }
        }
      }
    },
    "A soft Night page switches on in the evening, or read under the stars with Starlight.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suave página Noche se activa al anochecer, o lee bajo las estrellas con Noche estrellada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página Noite suave é ativada ao anoitecer, ou leia sob as estrelas com Noite estrelada."
          }
        }
      }
    },
    "A thorough Old Testament commentary attentive to the Hebrew text.": {
      "localizations": {
        "es": {
