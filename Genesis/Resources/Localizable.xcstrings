        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso de todos é mantido, e ele passa para Concluídos."
          }
        }
      }
    },
    "Everything else in Versely works on every iPhone and iPad that runs iOS 26. Groups, the community, sync and study notes need an internet connection; reading, listening with the device voice, search and your notes work offline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo demás en Versely funciona en cualquier iPhone y iPad con iOS 26. Los grupos, la comunidad, la sincronización y las notas de estudio necesitan conexión a internet; la lectura, escuchar con la voz del dispositivo, la búsqueda y tus notas funcionan sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o resto do Versely funciona em qualquer iPhone e iPad com iOS 26. Os grupos, a comunidade, a sincronização e as notas de estudo precisam de internet; a leitura, ouvir com a voz do dispositivo, a busca e suas anotações funcionam offline."
          }
        }
      }
    },
