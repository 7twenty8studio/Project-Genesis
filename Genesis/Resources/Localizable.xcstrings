    "Add a verse, then review it for a minute a day. Each time you remember it, the next review comes a little later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un versículo y repásalo un minuto al día. Cada vez que lo recuerdes, el siguiente repaso llegará un poco más tarde."
          }
        }
      }
    },
