    "People, places and events from Theographic Bible Metadata (CC BY-SA 4.0). Map locations and how certain they are from OpenBible.info (CC BY 4.0). Descriptions from Easton's Bible Dictionary (1897).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas, lugares y acontecimientos de Theographic Bible Metadata (CC BY-SA 4.0). Ubicaciones del mapa y su grado de certeza de OpenBible.info (CC BY 4.0). Descripciones del Diccionario Bíblico de Easton (1897), en inglés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pessoas, lugares e acontecimentos do Theographic Bible Metadata (CC BY-SA 4.0). Localizações do mapa e o grau de certeza do OpenBible.info (CC BY 4.0). Descrições do Dicionário Bíblico de Easton (1897), em inglês."
          }
        }
      }
    },
