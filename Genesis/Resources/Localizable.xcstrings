    "Add a verse, then review it for a minute a day. Each time you remember it, the next review comes a little later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un versículo y repásalo un minuto al día. Cada vez que lo recuerdes, el siguiente repaso llegará un poco más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um versículo e revise-o um minuto por dia. Cada vez que você lembrar, a próxima revisão vem um pouco mais tarde."
          }
        }
      }
    },
    "Add bookmark": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir marcador"
          }
        },
        "pt-BR": {
