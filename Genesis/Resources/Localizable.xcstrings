        }
      }
    },
    "A mistake in a Bible text": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un error en un texto bíblico"
          }
        }
      }
    },
    "A modern, readable translation in everyday English.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una traducción moderna y fácil de leer, en inglés cotidiano."
