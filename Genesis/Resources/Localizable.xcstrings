    "A question": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pregunta"
          }
        }
      }
    },
    "A short guide explains the differences and suggests a Bible for study, everyday reading or reading aloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve guía explica las diferencias y sugiere una Biblia para el estudio, la lectura diaria o la lectura en voz alta."
          }
        }
      }
    },
    "A timer that fades out": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador que se desvanece"
          }
        }
      }
    },
    "AI can make mistakes. Weigh these notes against Scripture itself. Explanations aim to be non-denominational and note where Christian traditions differ.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA puede equivocarse. Contrasta estas notas con la propia Escritura. Las explicaciones buscan no ser denominacionales e indican dónde difieren las tradiciones cristianas."
          }
        }
      }
    },
    "AI-generated study notes · not Scripture": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas de estudio generadas por IA · no son Escritura"
