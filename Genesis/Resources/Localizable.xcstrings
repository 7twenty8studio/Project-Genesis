    "Dotted words are in Nestle-Aland but not in the Textus Receptus, which leaves them out or reads differently.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras subrayadas con puntos están en Nestle-Aland pero no en el Textus Receptus, que las omite o dice otra cosa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras pontilhadas estão no Nestle-Aland, mas não no Textus Receptus, que as omite ou traz outra leitura."
          }
        }
      }
    },
