    "%@ is free to read, always. Listening isn't available for it, and Premium tools such as Memorize use the %@ instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La %@ es gratis para leer, siempre. No se puede escuchar, y las herramientas Premium como Memorizar usan la %@ en su lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ é gratuita para ler, sempre. Não é possível ouvi-la, e as ferramentas Premium como Memorizar usam a %@ no lugar dela."
          }
        }
      }
    },
    "%@ is praying for you. Read with me today?": {
      "comment": "Group nudge; also the push notification's text (group-notify NUDGE_BODY_KEY)",
