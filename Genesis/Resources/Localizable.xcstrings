        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe el versículo del día cada mañana y un recordatorio amable por la tarde si aún no has leído. Cambia las horas o desactívalos cuando quieras en Ajustes › Notificaciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba o versículo do dia toda manhã e um lembrete gentil à noite se ainda não tiver lido. Mude os horários ou desative quando quiser em Ajustes › Notificações."
          }
        }
      }
