          }
        }
      }
    },
    "Turn the page while choosing verses and they stay selected; swipe the bar down to put it away.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa la página mientras eliges versículos y seguirán seleccionados; desliza la barra hacia abajo para ocultarla."
