            "state": "translated",
            "value": "Adicionar marcador"
          }
        }
      }
    },
    "Add photos and voice recordings to a prayer or a sermon; they sync to your other devices through your iCloud.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fotos y grabaciones de voz a una oración o a un sermón; se sincronizan con tus otros dispositivos a través de tu iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione fotos e gravações de voz a uma oração ou a um sermão; elas sincronizam com seus outros dispositivos pelo seu iCloud."
          }
        }
      }
    },
    "Add photos and voice recordings to prayers and sermon notes, sketch with Apple Pencil, start from templates and export a beautifully typeset PDF.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fotos y grabaciones de voz a tus oraciones y notas de sermones, dibuja con el Apple Pencil, empieza desde plantillas y exporta un PDF con una tipografía cuidada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione fotos e gravações de voz às suas orações e anotações de sermões, desenhe com o Apple Pencil, comece por modelos e exporte um PDF com tipografia caprichada."
          }
        }
      }
    },
    "Add photos, voice recordings and Pencil pages with Premium.": {
      "localizations": {
        "es": {
