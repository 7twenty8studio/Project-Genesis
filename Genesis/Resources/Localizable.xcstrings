      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvia, olas del mar, viento, el crepitar del fuego, canto de aves y un suave fondo de adoración para leer y orar, mezclados a tu gusto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuva, ondas do mar, vento, o estalar do fogo, canto dos pássaros e um fundo suave de adoração para ler e orar, misturados do seu jeito."
          }
        }
      }
    },
