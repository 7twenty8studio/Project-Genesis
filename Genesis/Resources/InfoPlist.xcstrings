{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely uses the camera only when you take a photo to add to a prayer or sermon notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely usa la cámara solo cuando tomas una foto para añadirla a una oración o a tus notas de un sermón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Versely usa a câmera só quando você tira uma foto para adicionar a uma oração ou às anotações de um sermão."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely uses the microphone only when you record a voice note for a prayer or sermon notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely usa el micrófono solo cuando grabas una nota de voz para una oración o tus notas de un sermón."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Versely usa o microfone só quando você grava uma nota de voz para uma oração ou para as anotações de um sermão."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely saves the verse images and wallpapers you make to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versely guarda en tu fototeca las imágenes de versículos y los fondos de pantalla que creas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Versely salva na sua fototeca as imagens de versículos e os papéis de parede que você cria."
          }
        }
      }
    }
  },
  "version": "1.0"
}
