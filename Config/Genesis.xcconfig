// Shared build settings for Genesis.
// Secrets live in Secrets.xcconfig, which is git-ignored. Copy
// Secrets.example.xcconfig to Secrets.xcconfig and fill it in.
// The app builds and runs without it; sync and crash reporting stay off.

SUPABASE_URL =
SUPABASE_ANON_KEY =
SENTRY_DSN =
// Links on the Premium screen (see PHASE3_SETUP.md). Terms default to Apple's
// standard licence agreement; the privacy link is hidden until set.
GENESIS_TERMS_URL =
GENESIS_PRIVACY_URL =

// Entitlements (App Group for widgets, Sign in with Apple) need a development
// team. They stay off until Config/Signing.xcconfig exists; see PHASE2_SETUP.md.
GENESIS_APP_ENTITLEMENTS =
GENESIS_WIDGET_ENTITLEMENTS =
GENESIS_WATCH_ENTITLEMENTS =
// iCloud for attachment files; must match Config/Genesis.entitlements.
GENESIS_ICLOUD_CONTAINER =

#include? "Secrets.xcconfig"
#include? "Signing.xcconfig"
