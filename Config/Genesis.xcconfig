// Shared build settings for Versely (code name Genesis).
// Secrets live in Secrets.xcconfig, which is git-ignored. Copy
// Secrets.example.xcconfig to Secrets.xcconfig and fill it in.
// The app builds and runs without it; sync and crash reporting stay off.

SUPABASE_URL =
SUPABASE_ANON_KEY =
SENTRY_DSN =
// Links on the Premium screen and in Settings (see PHASE3_SETUP.md). Terms
// default to Apple's standard licence agreement; the privacy and support links
// are hidden until set. Set them in Secrets.xcconfig, with $(SLASH)$(SLASH).
GENESIS_TERMS_URL =
GENESIS_PRIVACY_URL =
GENESIS_SUPPORT_URL =

// Entitlements (App Group for widgets, Sign in with Apple, push, iCloud) need a development
// team. They stay off until Config/Signing.xcconfig exists; see APPLE_SETUP.md.
GENESIS_APP_ENTITLEMENTS =
GENESIS_WIDGET_ENTITLEMENTS =
GENESIS_WATCH_ENTITLEMENTS =
// iCloud for attachment files; must match Config/Genesis.entitlements.
GENESIS_ICLOUD_CONTAINER =
// The Meta (Facebook) App ID for "Share to Instagram Stories" (not a secret;
// developers.facebook.com › My Apps). Hidden until set.
GENESIS_FACEBOOK_APP_ID =

#include? "Secrets.xcconfig"
#include? "Signing.xcconfig"
