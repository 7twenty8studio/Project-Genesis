// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so URLs use $(SLASH)$(SLASH).
SLASH = /

SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
SENTRY_DSN = https:$(SLASH)$(SLASH)PUBLIC-KEY@oXXXX.ingest.us.sentry.io/PROJECT-ID
// Optional: shows "Share to Instagram Stories" on verse images.
GENESIS_FACEBOOK_APP_ID =
// Required before the App Store: your privacy policy and a support page with a
// way to contact you (Settings and the Premium screen link to them), e.g.
// https:$(SLASH)$(SLASH)7twenty8studio.com/versely/privacy
GENESIS_PRIVACY_URL =
GENESIS_SUPPORT_URL =
