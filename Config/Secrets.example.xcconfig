// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so URLs use $(SLASH)$(SLASH).
SLASH = /

SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
SENTRY_DSN = https:$(SLASH)$(SLASH)PUBLIC-KEY@oXXXX.ingest.us.sentry.io/PROJECT-ID
